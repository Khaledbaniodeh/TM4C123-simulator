# Normalize text files
* text=auto

# Binary assets
*.png binary

# Shell scripts run on Linux CI runners: always LF
*.sh text eol=lf

# Web workspace
apps/web/** linguist-documentation=false
apps/web/** linguist-generated=false
apps/web/** linguist-vendored=false

# Firmware: examples, fixtures, and bare-metal startup
examples/** linguist-documentation=false
examples/**/*.c linguist-language=C
tests/fixtures/** linguist-documentation=false
simulator/firmware/*.s linguist-language=Unix-Assembly

# Renode platform descriptions
*.repl linguist-language=YAML linguist-detectable=false
