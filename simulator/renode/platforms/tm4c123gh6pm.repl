// TM4C123GH6PM platform description for Renode.
//
// Requires the custom peripheral sources to be included first (in order):
//   simulator/renode/peripherals/TM4C123EventSink.cs
//   simulator/renode/peripherals/TM4C123SystemControl.cs
//   simulator/renode/peripherals/TM4C123GPIO.cs
//   simulator/renode/peripherals/TM4C123UnimplementedPeripheral.cs
//
// Addresses: TM4C123GH6PM datasheet (SPMS376E), Table 2-4 "Memory Map".
// Interrupt numbers: Table 2-9 "Interrupts".
// Anything not listed here is unmapped; Renode reports such accesses.

flash: Memory.MappedMemory @ sysbus 0x00000000
    size: 0x40000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x8000

// 3 implemented priority bits (PRIx[7:5]); SysTick clocked from the 16 MHz
// precision internal oscillator (PIOSC) default system clock.
nvic: IRQControllers.NVIC @ sysbus 0xE000E000
    priorityMask: 0xE0
    systickFrequency: 16000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic

sysctl: Miscellaneous.TM4C123SystemControl @ sysbus 0x400FE000

gpioPortA: GPIOPort.TM4C123GPIO @ sysbus 0x40004000
    systemControl: sysctl
    portIndex: 0
    IRQ -> nvic@0

gpioPortB: GPIOPort.TM4C123GPIO @ sysbus 0x40005000
    systemControl: sysctl
    portIndex: 1
    IRQ -> nvic@1

gpioPortC: GPIOPort.TM4C123GPIO @ sysbus 0x40006000
    systemControl: sysctl
    portIndex: 2
    IRQ -> nvic@2

gpioPortD: GPIOPort.TM4C123GPIO @ sysbus 0x40007000
    systemControl: sysctl
    portIndex: 3
    IRQ -> nvic@3

gpioPortE: GPIOPort.TM4C123GPIO @ sysbus 0x40024000
    systemControl: sysctl
    portIndex: 4
    IRQ -> nvic@4

gpioPortF: GPIOPort.TM4C123GPIO @ sysbus 0x40025000
    systemControl: sysctl
    portIndex: 5
    IRQ -> nvic@30

// ---------------------------------------------------------------------------
// Peripherals present on TM4C123GH6PM but not modeled yet. Accesses produce
// `unimplemented-peripheral-access` events (see TM4C123UnimplementedPeripheral.cs).
// Remove an entry here when a real model replaces it.
// ---------------------------------------------------------------------------

unimplWDT0: Miscellaneous.TM4C123UnimplementedPeripheral @ sysbus 0x40000000
    peripheralName: "WDT0"
    baseAddress: 0x40000000

unimplWDT1: Miscellaneous.TM4C123UnimplementedPeripheral @ sysbus 0x40001000
    peripheralName: "WDT1"
